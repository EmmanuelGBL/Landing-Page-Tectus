# Variáveis do build de produção. Versionadas de propósito: ver a nota no
# .gitignore. Nenhum valor aqui é segredo, os dois aparecem no HTML publicado.
#
# É este arquivo que a VPS usa ao rodar `npm run build`. Se ele sumir, o site
# continua subindo, só que com noindex e sem medição.

# Endereço final do site. É o que destrava a indexação: `INDEXAVEL`, em
# src/lib/site.ts, só é verdadeiro quando este valor bate com o domínio
# oficial. Faltando, o robots.txt sai com Disallow e a página com noindex.
NEXT_PUBLIC_SITE_URL=https://tectussolucoes.com.br

# Container do Google Tag Manager, criado em 03/09/2026. Dentro dele: a
# propriedade GA4 G-RFCX8J55HW e a tag de evento acionada pelos eventos da
# Tectus. Vazio ou ausente: nenhum script de medição é injetado.
NEXT_PUBLIC_GTM_ID=GTM-W2NBK5XF
