# Variáveis de ambiente do build. Copie para `.env.local` e preencha.
# Nenhuma delas é segredo: `NEXT_PUBLIC_` significa que o valor vai para o
# HTML publicado. Não colocar chave de API aqui.

# Endereço final do site. É ele que destrava a indexação: `INDEXAVEL`, em
# src/lib/site.ts, só é verdadeiro quando este valor bate com o domínio
# oficial. Faltando, a página sai com noindex e o robots.txt com Disallow.
# Na Netlify vinha injetado sozinho a partir de $URL. Fora dela, alguém
# precisa definir no build, ou o site sobe invisível para o Google.
NEXT_PUBLIC_SITE_URL=https://tectussolucoes.com.br

# Container do Google Tag Manager, criado em 03/09/2026.
# Vazio ou ausente: nenhum script de medição é injetado e nenhum evento sai.
# O GA4 e a tag de conversão do Google Ads são configurados dentro do
# container, não aqui.
#
# Não é segredo: este valor vai no HTML de toda página publicada. Fica escrito
# aqui porque perder o ID custa mais do que o risco de expô-lo, que é nenhum.
#
# Dentro do container: propriedade GA4 G-RFCX8J55HW (conta Tectus, fluxo
# "Site Principal"), uma Tag do Google em Initialization - All Pages e uma tag
# de evento genérica acionada pela regex dos eventos da Tectus.
NEXT_PUBLIC_GTM_ID=GTM-W2NBK5XF
